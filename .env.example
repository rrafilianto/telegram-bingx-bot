# ==========================================
# BingX API Credentials
# Create your API Key at: https://bingx.com/en/accounts/api
# Make sure Perpetual Futures Trading permissions are enabled.
# ==========================================
BINGX_API_KEY=your_bingx_api_key_here
BINGX_SECRET_KEY=your_bingx_secret_key_here

# Environment mode: prod-vst (VST Demo / Paper Trading) or prod-live (Real Money Trading)
BINGX_ENV=prod-vst

# ==========================================
# Telegram Bot Credentials
# Obtain your bot token from @BotFather on Telegram
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User / Chat ID
# Tip: Leave empty initially if unknown; the bot will auto-detect your Chat ID when you send /start
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ==========================================
# Optional Trading & Risk Settings (Defaults shown)
# ==========================================
# DEFAULT_LEVERAGE=10
# MARGIN_TYPE=ISOLATED
# MAX_CONCURRENT_POSITIONS=3
# RISK_PER_TRADE_PERCENT=2.0
# MAX_DAILY_DRAWDOWN_PERCENT=5.0
# COOLDOWN_MINUTES_AFTER_LOSS=45

# ==========================================
# Optional Scanner & Trailing TP Settings
# ==========================================
# SCAN_INTERVAL_MINUTES=5
# MONITOR_INTERVAL_SECONDS=15
# BREAK_EVEN_TRIGGER_R=1.0
# TRAILING_ACTIVATION_R=1.5
# TRAILING_ATR_MULTIPLIER=1.0
# TRAILING_MIN_CALLBACK_RATE=0.006
# TRAILING_MAX_CALLBACK_RATE=0.025

# ==========================================
# Optional Notification & Timezone Settings
# ==========================================
# DAILY_SUMMARY_HOUR=8
# DAILY_SUMMARY_MINUTE=0
# TIME_ZONE=Asia/Jakarta
# BLACKLIST_SYMBOLS=LUNA-USDT,USTC-USDT
